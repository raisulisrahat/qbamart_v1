Options -MultiViews
RewriteEngine On
RewriteBase /

# ------------------------------------------------------------------
# Social Media Crawler → Django SEO Proxy
# When Facebook/WhatsApp/Telegram etc. crawl a product or blog URL,
# redirect them to the Django backend which renders server-side HTML
# with the correct og:title, og:description, og:image for that page.
# ------------------------------------------------------------------

RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|Discordbot|Slackbot|LinkedInBot|googlebot|bingbot|rogerbot|DuckDuckBot|ia_archiver) [NC]
RewriteCond %{REQUEST_URI} ^/(product|blog|offer|step)/ [NC]
RewriteRule ^(.*)$ https://api.qbamart.com/api/seo-proxy/?path=/$1 [L,R=302]

# ------------------------------------------------------------------
# Redirect sitemap.xml to Django backend dynamic sitemap
# ------------------------------------------------------------------
RewriteRule ^sitemap\.xml$ https://api.qbamart.com/sitemap.xml [L,R=302]

# ------------------------------------------------------------------
# React SPA fallback — serve index.html for all other routes
# ------------------------------------------------------------------
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]


<IfModule mod_deflate.c>
    # Compress HTML, CSS, JavaScript, Text, XML and fonts
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
</IfModule>

# ------------------------------------------------------------------
# Browser Caching (Expires Headers) for LiteSpeed/Apache on cPanel
# ------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Default expiry time (1 month)
    ExpiresDefault "access plus 1 month"
    
    # CSS & JavaScript (Vite fingerprinted files are cached for 1 year)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # HTML (Never cache index.html to ensure clients get updates immediately)
    ExpiresByType text/html "access plus 0 seconds"
    
    # Images & Favicon
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    
    # Fonts
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresByType font/truetype "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Cache Vite fingerprinted assets for 1 year with immutable tag
    <FilesMatch "\.(js|css|woff2?|eot|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Cache other images and media files for 1 month
    <FilesMatch "\.(ico|png|jpg|jpeg|webp|gif|svg)$">
        Header set Cache-Control "public, max-age=2592000, must-revalidate"
    </FilesMatch>

    # Make sure HTML is never cached
    <FilesMatch "\.html$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </FilesMatch>
</IfModule>