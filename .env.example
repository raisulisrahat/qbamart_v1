# --- Django Settings ---
DEBUG=False
SECRET_KEY=generate_a_secure_random_key_here
ALLOWED_HOSTS=dev.qbamart.com,qbamart.com
CORS_ALLOWED_ORIGINS=https://dev.qbamart.com,https://qbamart.com
CSRF_TRUSTED_ORIGINS=https://dev.qbamart.com,https://qbamart.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True

# --- Database Settings ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=qbamart_db
DB_USER=qbamart_admin
DB_PASSWORD=your_secure_password
DB_HOST=db
DB_PORT=5432

# --- Security ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- Frontend Settings ---
VITE_API_URL=https://dev.qbamart.com
